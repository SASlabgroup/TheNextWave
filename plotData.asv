clear; close all; clc; 

%% Directories
addpath(genpath('..\SWIFT-codes'))
exampleNum = 1;
dataFolder = fullfile(pwd,strcat('ExampleData',num2str(exampleNum)));

%% Load data
load(fullfile(dataFolder,"processedData.mat"))

%% Plotting
markerVec = 'x*s^';
colors = cbrewer('qual','Set1',9);
colors_pred = cbrewer('qual','Pastel1',9);
plot_ind = 1;

%% Plot buoy locations
circleThetaVec = 0:0.01:2*pi;
f1 = figure();
plot(0,0,'ko')
hold on
grid on
for jj = 1:params.nbuoys
    xcirc = mean(data.x(:,jj)) + (params.lambdae/4)*cos(circleThetaVec);
    ycirc = mean(data.y(:,jj)) + (params.lambdae/4)*sin(circleThetaVec);
    plot(data.x(:,jj)/params.lambdae,data.y(:,jj)/params.lambdae,'Color',colors(jj,:),'Marker',markerVec(jj))
    plot(xcirc/params.lambdae,ycirc/params.lambdae,'Color',colors(jj,:))
end
plot(data.x_target/params.lambdae,data.y_target/params.lambdae,'rv')
axis equal
xlabel('$\frac{x}{\lambda_e}$')
ylabel('$\frac{y}{\lambda_e}$')
title(strcat("$\lambda_{e}$ = ",num2str(round(params.lambdae,2))," m"))

%% Plot time series
if(params.use_vel)
    numSubPlots = 5;
else
    numSubPlots = 3;
end

f2 = figure();
ax1(1) = subplot(numSubPlots,1,1);
hold on
grid on
% xline(t(indWindowStart(count)),'k','linewidth',1.5)
% xline(t(indWindowEnd(count)),'k','linewidth',1.5)
% xline(t(predWindowStart(count)),'b','linewidth',1.5)
% xline(t(predWindowEnd(count)),'b','linewidth',1.5)
ylabel('$x_{in}$')

ax1(2) = subplot(numSubPlots,1,2);
hold on
grid on
% xline(t(indWindowStart(count)),'k','linewidth',1.5)
% xline(t(indWindowEnd(count)),'k','linewidth',1.5)
% xline(t(predWindowStart(count)),'b','linewidth',1.5)
% xline(t(predWindowEnd(count)),'b','linewidth',1.5)
ylabel('$y_{in}$')

ax1(3) = subplot(numSubPlots,1,3);
hold on
grid on
% xline(t(indWindowStart(count)),'k','linewidth',1.5)
% xline(t(indWindowEnd(count)),'k','linewidth',1.5)
% xline(t(predWindowStart(count)),'b','linewidth',1.5)
% xline(t(predWindowEnd(count)),'b','linewidth',1.5)
ylabel('$z_{in}$')

for ii = 1:params.nbuoys
    plot(ax1(1),data.t,data.x(:,ii),'Color',colors(ii,:))
    plot(ax1(2),data.t,data.y(:,ii),'Color',colors(ii,:))
    plot(ax1(3),data.t,data.z(:,ii),'Color',colors(ii,:))
end

if(params.use_vel)
    ax1(4) = subplot(numSubPlots,1,4);
    hold on
    grid on
    % xline(t(indWindowStart(count)),'k','linewidth',1.5)
    % xline(t(indWindowEnd(count)),'k','linewidth',1.5)
    % xline(t(predWindowStart(count)),'b','linewidth',1.5)
    % xline(t(predWindowEnd(count)),'b','linewidth',1.5)
    ylabel('$u_{in}$')

    ax1(5) = subplot(5,1,5);
    hold on
    grid on
    % xline(t(indWindowStart(count)),'k','linewidth',1.5)
    % xline(t(indWindowEnd(count)),'k','linewidth',1.5)
    % xline(t(predWindowStart(count)),'b','linewidth',1.5)
    % xline(t(predWindowEnd(count)),'b','linewidth',1.5)
    xlabel('Time [s]')
    ylabel('$v_{in}$')

    for ii = 1:params.nbuoys
        plot(ax1(4),data.t,data.u(:,ii),'Color',colors(ii,:))
        plot(ax1(5),data.t,data.v(:,ii),'Color',colors(ii,:))
    end
else
    xlabel('Time [s]')
end

linkaxes(ax1,'x')

%% Plot reconstruction and prediction
%%% time series
% wave elevation
f3 = figure();
for ii = 1:params.nbuoys
    subplot(params.nbuoys,1,ii)
    plot(NaN,NaN,'-','Color',colors(1,:))
    hold on
    grid on
    plot(NaN,NaN,'k-')
    plot(NaN,NaN,'-','Color',[1 1 1]*0.7)

    plot(data.t_in(:,ii),data.z_in(:,ii),'Color',colors(ii,:))
    hold on
    grid on
    plot(data.t_in(:,ii),sol.lsq.z_recon(:,ii),'k')

    for jj = 1:length(params.predBuoy)
        if(ii == params.predBuoy(jj))
            plot(data.t_pred_in(:,jj),data.z_pred_in(:,jj),'Color',colors_pred(ii,:))
            plot(data.t_pred_in(:,jj),sol.lsq.z_pred(:,jj),'Color',[1 1 1]*0.7)
        end
    end

    xlim([data.t_in(1,1) data.t_pred_in(end)])
    xlim([40 150])
    ylabel('$z$ [m]')

    if(ii == 1)
        title('Wave Elevation Reconstruction and Prediction')
        legend('Measured','Recreated','Prediction')
    end
end
xlabel('Time [s]')

% velocities
if(params.use_vel)
    f4 = figure();
    for ii = 1:params.nbuoys
        subplot(params.nbuoys,1,ii)
        plot(NaN,NaN,'-','Color',colors(1,:))
        hold on
        grid on
        plot(NaN,NaN,'k-')
        plot(NaN,NaN,'-','Color',[1 1 1]*0.7)

        plot(data.t_in(:,ii),data.u_in(:,ii),'Color',colors(ii,:))
        hold on
        grid on
        plot(data.t_in(:,ii),sol.lsq.u_recon(:,ii),'k')

    for jj = 1:length(params.predBuoy)
        if(ii == params.predBuoy(jj))
            plot(data.t_pred_in(:,jj),data.u_pred_in(:,jj),'Color',colors_pred(ii,:))
            plot(data.t_pred_in(:,jj),sol.lsq.u_pred(:,jj),'Color',[1 1 1]*0.7)
        end
    end

        xlim([data.t_in(1,1) data.t_pred_in(end)])
        xlim([40 150])
        ylabel('$u$ [m/s]')

        if(ii == 1)
            title('Horizontal Velocity Reconstruction and Prediction')
            legend('Measured','Recreated','Prediction')
        end
    end
    xlabel('Time [s]')

    f5 = figure();
    for ii = 1:params.nbuoys
        subplot(params.nbuoys,1,ii)
        plot(NaN,NaN,'-','Color',colors(1,:))
        hold on
        grid on
        plot(NaN,NaN,'k-')
        plot(NaN,NaN,'-','Color',[1 1 1]*0.7)

        plot(data.t_in(:,ii),data.v_in(:,ii),'Color',colors(ii,:))
        hold on
        grid on
        plot(data.t_in(:,ii),sol.lsq.v_recon(:,ii),'k')

    for jj = 1:length(params.predBuoy)
        if(ii == params.predBuoy(jj))
            plot(data.t_pred_in(:,jj),data.v_pred_in(:,jj),'Color',colors_pred(ii,:))
            plot(data.t_pred_in(:,jj),sol.lsq.v_pred(:,jj),'Color',[1 1 1]*0.7)
        end
    end

        xlim([data.t_in(1,1) data.t_pred_in(end)])
        xlim([40 150])
        ylabel('$v$ [m/s]')

        if(ii == 1)
            title('Horizontal Velocity Reconstruction and Prediction')
            legend('Measured','Recreated','Prediction')
        end
    end
    xlabel('Time [s]')
end
    
%% amplitudes
f6 = figure();
subplot(1,2,1)
plot(sol.lsq.A,'ko')
hold on
grid on
plot(sol.lsq.lims,'Color',[1 1 1]*0.7)
plot(-sol.lsq.lims,'Color',[1 1 1]*0.7)
legend('$A_{lsq}$','lims')
xlabel('Index')
ylabel('Amplitude')
title('Solution Amplitudes and Limits - LSQ')

subplot(1,2,2)
plot(sol.bs.A,'ko')
hold on
grid on
% plot(lims,'Color',[1 1 1]*0.7)
% plot(-lims,'Color',[1 1 1]*0.7)
legend('$A_{bs}$','lims')
xlabel('Index')
ylabel('Amplitude')
title('Solution Amplitudes and Limits - BS')

%% error
f7 = figure();
f7.Position = [243.4,211.8,1163.6,420];
if(params.use_vel)
    subplot(1,2,1)
    b1 = bar([sol.lsq.z_recon_error(plot_ind,:); sol.lsq.u_recon_error(plot_ind,:); sol.lsq.v_recon_error(plot_ind,:)]);
    for ii = 1:params.nbuoys
        b1(ii).FaceColor = colors(ii,:);
    end
    hold on
    grid on
    legend('buoy 1','buoy 2','buoy 3','buoy 4','location','northwest')
    xticklabels({'z','u','v'})
    ylabel('Normalized error')
    title('Reconstruction')

    subplot(1,2,2)
    b2 = bar([sol.lsq.z_pred_error(plot_ind,:); sol.lsq.u_pred_error(plot_ind,:); sol.lsq.v_pred_error(plot_ind,:)]);
    for ii = 1:length(params.predBuoy)
        b2(ii).FaceColor = colors_pred(params.predBuoy(ii),:);
    end
    hold on
    grid on
    xticklabels({'z','u','v'})
    title('Prediction')
else
    subplot(1,2,1)
    bar([sol.lsq.z_recon_error(plot_ind,:)])
    hold on
    grid on
    legend('buoy 1','buoy 2','buoy 3','buoy 4','location','northwest')
    xticklabels({'z'})
    ylabel('Normalized error')
    title('Reconstruction')

    subplot(1,2,2)
    bar([sol.lsq.z_pred_error(plot_ind,:)])
    hold on
    grid on
    xticklabels({'z'})
    title('Prediction')
end

%% Plotting
t_plot_recon = t(round((data.indWindowEnd-data.indWindowStart)/2)+data.indWindowStart);
t_plot_pred = t(round((data.predWindowEnd-data.predWindowStart)/2)+data.predWindowStart);

data.t_plot_recon = t_plot_recon;
data.t_plot_pred = t_plot_pred;

%%% Error
% z
figure;
subplot(2,1,1)
for ii = 1:nbuoys
    plot(t_plot_recon,data.z_recon_error_lsq(:,ii),'Color',colors(ii,:))
    hold on
    grid on
end
xlim([data.t(1) data.t(end)])
ylim([0 1])
ylabel('Error')
title('$z$ Reconstruction')

subplot(2,1,2)
for ii = 1:nbuoys
    for jj = 1:length(predBuoy)
        if(ii == predBuoy(jj))
            plot(t_plot_pred,data.z_pred_error_lsq(:,jj),'Color',colors_pred(ii,:))
            hold on
            grid on
        end
    end
end
xlim([data.t(1) data.t(end)])
xlabel('Time [s]')
ylabel('Error')
title('$z$ Prediction')

if(use_vel)
    % u
    figure;
    subplot(2,1,1)
    for ii = 1:nbuoys
        plot(t_plot_recon,data.u_recon_error_lsq(:,ii),'Color',colors(ii,:))
        hold on
        grid on
    end
    xlim([data.t(1) data.t(end)])
    ylim([0 1])
    ylabel('Error')
    title('$u$ Reconstruction')

    subplot(2,1,2)
    for ii = 1:nbuoys
        for jj = 1:length(predBuoy)
            if(ii == predBuoy(jj))
                plot(t_plot_pred,data.u_pred_error_lsq(:,jj),'Color',colors_pred(ii,:))
                hold on
                grid on
            end
        end
    end
    xlim([data.t(1) data.t(end)])
    xlabel('Time [s]')
    ylabel('Error')
    title('$u$ Prediction')

    % v
    figure;
    subplot(2,1,1)
    for ii = 1:nbuoys
        plot(t_plot_recon,data.v_recon_error_lsq(:,ii),'Color',colors(ii,:))
        hold on
        grid on
    end
    xlim([data.t(1) data.t(end)])
    ylim([0 1])
    ylabel('Error')
    title('$v$ Reconstruction')

    subplot(2,1,2)
    for ii = 1:nbuoys
        for jj = 1:length(predBuoy)
            if(ii == predBuoy(jj))
                plot(t_plot_pred,data.v_pred_error_lsq(:,jj),'Color',colors_pred(ii,:))
                hold on
                grid on
            end
        end
    end
    xlim([data.t(1) data.t(end)])
    xlabel('Time [s]')
    ylabel('Error')
    title('$v$ Prediction')
end
